DB_NAME=daret_digital
DB_USER=daret_user
DB_PASSWORD=change-me

# At least 32 characters (it is used as the raw HS256 key, no base64 decoding)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Stripe test mode keys only
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# {groupId} is replaced by the backend. The path must match your frontend route.
STRIPE_SUCCESS_URL=http://localhost:3000/membre/daret/{groupId}?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/membre/daret/{groupId}?payment=cancelled

MANUAL_PAYMENTS=false

# URL the browser uses to reach the backend and the frontend
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
